            "enum": [
              "work",
              "home",
              "personal"
            ]
          },
          "userId": {
            "description": "Contacts's user id",
            "type": "string",
            "example": "6676ebc8d7c1721bb6534fc0"
          },
          "photo": {
            "description": "Link to contacts's photo",
            "type": "string",
            "example": "https://res.cloudinary.com/ddashlavv/image/upload/v1720174457/byzta451bbi5v2j2p003.jpg"
          }
        }
      },
      "user": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "_id": {
            "description": "User's id",
            "type": "string",
            "example": "6676ebc8d7c1721bb6534fc0"
          },
          "name": {
            "description": "User's name",
            "type": "string",
            "example": "Inna Boiko"
          },
          "email": {
            "description": "User's email",
            "type": "string",
            "example": "inna_boiko@libero.it"
          },
          "password": {
            "description": "User's password",
            "type": "string",
            "example": "password"
          }
        }
      }
    },
    "responses": {
      "401": {
        "description": "Unauthorized error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "status",
                "message",
                "data"
              ],
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 401
                },
